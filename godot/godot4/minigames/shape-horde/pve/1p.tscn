[sub_resource type="GDScript" id="GDScript_qu4h1"]
script/source = "extends Area2D


func _on_body_entered(body: Node2D) -> void:
	if body is Ship and not body.is_dashing():
		body.kill()
		
	if body is Shapeoid:
		body.kill()
"

