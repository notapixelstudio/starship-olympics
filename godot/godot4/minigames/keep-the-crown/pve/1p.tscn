[sub_resource type="GDScript" id="GDScript_gbqai"]
script/source = "extends Orchestrator

var _started := false
var _current_turrets : Array[Turret] = []

func _ready():
	await super()
	
	%AutoSignals \\
		.bind(%ArenaScope.cargo_loaded, _on_cargo_loaded) \\
		.bind(%ArenaScope.cargo_unloaded, _on_cargo_unloaded)
	
	print('phase 0')
	
	# if there are no already loaded crowns, do nothing at start
	await get_tree().process_frame
	for ship in get_tree().get_nodes_in_group('Ship'):
		if ship.has_cargo_class(Crown):
			_begin_phases()
			break
	

func _on_cargo_unloaded(cargo: Cargo, by_ship: Ship) -> void:
	if cargo is Crown:
		disable_current_turrets()

func _on_cargo_loaded(cargo: Cargo, by_ship: Ship) -> void:
	if not(cargo is Crown):
		return
		
	if not _started:
		_begin_phases()
	alert_current_turrets()
	
func alert_current_turrets() -> void:
	for turret in _current_turrets:
		turret.alert()
		turret.set_targets(get_tree().get_nodes_in_group('Ship'))
		
func disable_current_turrets() -> void:
	for turret in _current_turrets:
		turret.stand_down()
		
# TODO: change system to danger level - each time a turret is hit another one is activated after a while
# level 1: 1 turret at random, starting from the top one
# after the first threshold, go to level 2
# level 2: left and right turrets (start with these)
# after the second threshold, go to level 3
# level 3: all turrets are active
func _begin_phases():
	print('phase 1')
	_current_turrets = [[%PewTurretTop, %PewTurretBottom].pick_random()]
	alert_current_turrets()
	
	await Events.score_threshold_passed
	
	print('phase 2')
	disable_current_turrets()
	_current_turrets = [%PewTurretLeft, %PewTurretRight]
	alert_current_turrets()
	
	await Events.score_threshold_passed
	
	print('phase 3')
	disable_current_turrets()
	_current_turrets = [%PewTurretTop, %PewTurretBottom]
	alert_current_turrets()
	
	await Events.score_threshold_passed
	print('phase 3b')
	disable_current_turrets()
	_current_turrets = [%PewTurretLeft, %PewTurretRight, %PewTurretTop, %PewTurretBottom]
	alert_current_turrets()
"

