[sub_resource type="GDScript" id="GDScript_gbqai"]
script/source = "extends Orchestrator

func _ready():
	await super()
	# do nothing at start
	print('phase 0')
	
# start as soon as the crown is loaded by someone
func _on_crown_loaded_by(actor: Ship) -> void:
	_begin_phases()

# TODO: change system to danger level - each time a turret is hit another one is activated after a while
# level 1: 1 turret at random, starting from the top one
# after the first threshold, go to level 2
# level 2: left and right turrets (start with these)
# after the second threshold, go to level 3
# level 3: all turrets are active
func _begin_phases():
	print('phase 1')
	%PewTurretTop.alert()
	await %PewTurretTop.alert_ended
	%PewTurretTop.enabled = true
	
	await Events.score_threshold_passed
	print('phase 2')
	%PewTurretTop.enabled = false
	%PewTurretLeft.alert()
	%PewTurretRight.alert()
	await %PewTurretLeft.alert_ended
	%PewTurretLeft.enabled = true
	%PewTurretRight.enabled = true
	
	await Events.score_threshold_passed
	print('phase 3')
	%PewTurretLeft.enabled = false
	%PewTurretRight.enabled = false
	%PewTurretTop.alert()
	%PewTurretBottom.alert()
	await %PewTurretTop.alert_ended
	%PewTurretTop.enabled = true
	%PewTurretBottom.enabled = true
	
	await Events.score_threshold_passed
	print('phase 3b')
	%PewTurretLeft.alert()
	%PewTurretRight.alert()
	%PewTurretTop.alert()
	%PewTurretBottom.alert()
	await %PewTurretLeft.alert_ended
	%PewTurretLeft.enabled = true
	%PewTurretRight.enabled = true
"

