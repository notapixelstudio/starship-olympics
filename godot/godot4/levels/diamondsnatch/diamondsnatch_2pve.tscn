[sub_resource type="GDScript" id="GDScript_2yg2a"]
script/source = "extends Orchestrator

func _ready():
	await super()
	
	await Events.score_threshold_passed
	%TimeManager.stop()
	await get_tree().create_timer(5).timeout
	%TimeManager.start()
	
	await Events.score_threshold_passed
	%TimeManager.stop()
	await get_tree().create_timer(5).timeout
	%TimeManager.start()
"

